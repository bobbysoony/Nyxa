{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:app:allow-exit",
    "opener:default",
    "dialog:default",
    "fs:default",
    "store:default",
    "fs:allow-appdata-write-recursive",
    "sql:default",
    "sql:allow-execute",
    "oauth:allow-start",
    "oauth:allow-cancel",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://oauth2.googleapis.com/*" }, { "url": "https://www.googleapis.com/*" }]
    }
  ]
}
